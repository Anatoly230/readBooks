		{"id":"1f944c640556c1fa","type":"text","text":" ```js\nvar a = 1;\nlet x = 8;\nfunction foo(x) {\n    var d = 30;\n    let b = 2;\n    if (x > 0) {\n        const c = 3;\n        console.log(a, b, c, x, d);\n    }\n    while (a < 10) {\n        let v = b + a;\n        a += v;\n        b += v;\n\n       d += v;\n        x += v;\n    }\n}\nfoo(5);\n ```","x":-1760,"y":-60,"width":400,"height":460},
